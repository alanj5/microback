file(MAKE_DIRECTORY "${TEST_ROOT}")
set(input "${TEST_ROOT}/protected.mkt.tmp")
set(output "${TEST_ROOT}/protected.mkt")
configure_file("${FIXTURE}" "${input}" COPYONLY)
file(SHA256 "${input}" expected)
execute_process(COMMAND "${CONVERTER}" "${input}" "${output}" RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Conversion failed: ${error}")
endif()
file(SHA256 "${input}" actual)
if(NOT actual STREQUAL expected)
  message(FATAL_ERROR "Converter modified its input")
endif()
execute_process(COMMAND "${CONVERTER}" "${input}" "${input}" RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(result EQUAL 0)
  message(FATAL_ERROR "Same input/output was accepted")
endif()
file(SHA256 "${output}" expected_output)
file(WRITE "${TEST_ROOT}/bad.csv" "timestamp_ns,sequence,order_id,price_ticks,quantity_lots,type,side\n1,1,1,0,0,Cancel,Buy\n")
execute_process(COMMAND "${CONVERTER}" "${TEST_ROOT}/bad.csv" "${output}" RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(result EQUAL 0)
  message(FATAL_ERROR "Malformed replay was accepted")
endif()
file(SHA256 "${output}" actual_output)
if(NOT actual_output STREQUAL expected_output)
  message(FATAL_ERROR "Failed conversion replaced existing output")
endif()
file(GLOB leftovers "${TEST_ROOT}/.microback-*")
if(leftovers)
  message(FATAL_ERROR "Temporary directory not cleaned up")
endif()
